          "type": "string",
          "example": "Friendly and playful."
        },
        "arrivalDate": {
          "type": "string",
          "example": "2023-10-01"
        },
        "isVaccinated": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "Application": {
      "type": "object",
      "properties": {
        "applicantName": {
          "type": "string",
          "example": "Jane Doe"
        },
        "email": {
          "type": "string",
          "example": "jane@example.com"
        },
        "petId": {
          "type": "string",
          "example": "650c... (ObjectId)"
        },
        "status": {
          "type": "string",
